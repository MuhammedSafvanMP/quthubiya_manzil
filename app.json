{
  "expo": {
    "name": "Quthubiya Manzil",
    "slug": "QuthubiyaManzil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "quthubiyamanzil",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/splash-logo.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to calculate the Qibla direction.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.safvanmp.QuthubiyaManzil"
    },
    "android": {
      "blockedPermissions": ["android.permission.ACTIVITY_RECOGNITION"],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon.png",
        "backgroundImage": "./assets/android-icon.png",
        "monochromeImage": "./assets/android-icon.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.safvanmp.QuthubiyaManzil"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We need your location to calculate the Qibla direction."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-logo.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-logo.png",
          "largeIcon": "./assets/splash-logo.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": [
            "./assets/audio/vank_15sec.wav",
            "./assets/audio/testing.wav"
          ],
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "488e9eac-4466-4365-8dcc-644aa3069f2e"
      }
    }
  }
}
